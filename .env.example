# Integration tests (npm run test:integration). They run against staging by default.
LIGUELEAD_API_TOKEN=
LIGUELEAD_APP_ID=
# Defaults to https://homolog-api.liguelead.com.br/v1. A production host is refused unless
# LIGUELEAD_IT_ALLOW_PRODUCTION=true.
LIGUELEAD_BASE_URL=
LIGUELEAD_IT_ALLOW_PRODUCTION=false
# Creates and deletes resources it can clean up (apps, voice actions).
LIGUELEAD_IT_ALLOW_WRITES=false
# Creates what the API has no DELETE for (voice uploads, RCS templates, voice agents).
LIGUELEAD_IT_ALLOW_PERSISTENT_WRITES=false
# Sends real campaigns, which cost credits, to LIGUELEAD_IT_PHONE.
LIGUELEAD_IT_ALLOW_SENDS=false
LIGUELEAD_IT_PHONE=
