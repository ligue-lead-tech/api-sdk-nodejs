{
  "name": "@liguelead/api-sdk",
  "version": "1.3.1",
  "description": "Node.js SDK for the LigueLead API: SMS, voice, RCS and voice AI campaigns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligue-lead-tech/api-sdk-nodejs.git"
  },
  "homepage": "https://github.com/ligue-lead-tech/api-sdk-nodejs#readme",
  "bugs": {
    "url": "https://github.com/ligue-lead-tech/api-sdk-nodejs/issues"
  },
  "keywords": [
    "liguelead",
    "sms",
    "rcs",
    "voice",
    "api",
    "sdk"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=18.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --selectProjects unit",
    "coverage": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "check:package": "npm pack --dry-run && attw --pack .",
    "prepack": "npm run build",
    "check:structure": "node scripts/check-structure.mjs",
    "test:tooling": "node --test eslint-rules/*.test.mjs scripts/*.test.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.130",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  }
}
